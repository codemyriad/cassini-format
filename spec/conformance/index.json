  "notCovered": [
    "the two pre-publication draft formats, which were never public"
  ],
  "updated": "2026-09-07",
  "profiles": {
    "metadata": "Decodes the tags and the chunk sets and verifies every declared payload SHA-256 and byte count. Does not read the audio. Such a reader reports audioTrust 'not-checked' and never 'verified'.",
    "full": "Everything a metadata reader does, plus exact-opus-audio-v1 over the compressed audio packets."
  },
