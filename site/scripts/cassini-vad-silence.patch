+package transcribe
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestVADSilenceBoundsPreserveSeparatedSpeech(t *testing.T) {
+	const rate = 16000
+	samples := make([]float32, 13*rate)
+	// A short backchannel, a long quiet interval, then a full sentence. The
+	// old fixed-window plan cut the sentence to give its final child context.
+	for i := 0; i < rate/2; i++ {
+		samples[i] = .1
+	}
+	for i := 8 * rate; i < len(samples); i++ {
+		samples[i] = .1
+	}
+	want := []windowBound{{start: 0, end: 7 * rate / 10}, {start: 78 * rate / 10, end: len(samples)}}
+	got := vadSilenceBounds(samples, rate)
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("bounds = %#v; want %#v", got, want)
+	}
+	// Every sounding sample keeps its original position in a retained slice;
+	// both boundaries sit in silence with 200 ms of onset/tail context.
+	for i, value := range samples {
+		if value == 0 {
+			continue
+		}
+		covered := false
+		for _, bound := range got {
+			covered = covered || i >= bound.start && i < bound.end
+		}
+		if !covered {
+			t.Fatalf("speech sample %d was excluded", i)
+		}
+	}
+}
+
+func TestVADSilenceBoundsLeaveOrdinaryPausesAndContinuousSpeechAlone(t *testing.T) {
+	const rate = 16000
+	for _, pauseMS := range []int{0, 300, 990} {
+		samples := make([]float32, 13*rate)
+		for i := range samples {
+			samples[i] = .1
+		}
+		clear(samples[6*rate : 6*rate+pauseMS*rate/1000])
+		got := vadSilenceBounds(samples, rate)
+		want := []windowBound{{start: 0, end: len(samples)}}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%d ms pause changed existing window behavior: %#v", pauseMS, got)
+		}
+	}
+}
+
+func TestVADSilenceBoundsPreserveSustainedSparseEnergy(t *testing.T) {
+	const rate = 16000
+	samples := make([]float32, 13*rate)
+	for i := range samples {
+		samples[i] = .1
+	}
+	// This quieter 100 Hz pulse train has 2 ms of active samples in every
+	// 10 ms frame. Its peak (.002) and RMS (~.000894) comfortably pass the
+	// word gate, but requiring 5 ms of activity in each frame would classify
+	// the entire three seconds as silence and discard the middle 2.6 seconds.
+	for i := 5 * rate; i < 8*rate; i++ {
+		switch {
+		case i%160 < 16:
+			samples[i] = .002
+		case i%160 < 32:
+			samples[i] = -.002
+		default:
+			samples[i] = 0
+		}
+	}
+	words := []Word{{Text: "quiet", StartMS: 6000, EndMS: 6400}}
+	if got := filterWordsByEnergy(samples, rate, words); len(got) != 1 {
+		t.Fatal("fixture should pass the existing word-energy gate")
+	}
+	want := []windowBound{{start: 0, end: len(samples)}}
+	if got := vadSilenceBounds(samples, rate); !reflect.DeepEqual(got, want) {
+		t.Fatalf("sustained audio passing the word gate was split: %#v", got)
+	}
+}
+
+func TestVADSilenceBoundsDoNotResegmentShortOrSilentSpans(t *testing.T) {
+	const rate = 16000
+	for _, length := range []int{0, 5 * rate, 105 * rate / 10, 13 * rate} {
+		samples := make([]float32, length)
+		got := vadSilenceBounds(samples, rate)
+		want := []windowBound{{start: 0, end: length}}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("silent span of %d samples split: %#v", length, got)
+		}
+	}
+	samples := make([]float32, 10*rate)
+	samples[0], samples[len(samples)-1] = .1, .1
+	if got := vadSilenceBounds(samples, rate); len(got) != 1 {
+		t.Fatalf("short span was resegmented: %#v", got)
+	}
+}
