 func (r *Recognizer) transcribeSegment(samples []float32, sampleRate int, segOffsetMS int64, vadSegment bool) ([]Word, error) {
+	// Silero can keep a brief acknowledgement and a later turn in one span,
+	// even across several seconds of silence. Fixed windows then spend most
+	// of their context on that silence and can bisect the later turn. Separate
+	// those acoustic islands first, keeping their original clock and padding.
+	if vadSegment {
