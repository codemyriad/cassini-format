+// vadSilenceBounds refines only spans that would otherwise need fixed windows.
+// A full second below the existing word-energy criteria is deliberately more
+// conservative than Silero's half-second pause setting. Each retained island
+// keeps 200 ms of the measured quiet run on both sides; only its silent middle
+// is omitted from ASR input, never from the recording or its timebase.
+func vadSilenceBounds(samples []float32, sampleRate int) []windowBound {
+	whole := []windowBound{{start: 0, end: len(samples)}}
+	if sampleRate <= 0 || len(samples) <= scaleSamples(vadDecodeWindowSamples+vadDecodeWindowGrace, sampleRate) {
+		return whole
+	}
+	window := max(1, sampleRate*int(wordEndScanWindowMS)/1000)
+	minimumActive := (sampleRate*minimumActiveDurationMS + 999) / 1000
+	handle := sampleRate * int(wordEnergyPostMarginMS) / 1000
+	minimumQuiet := sampleRate // one second
+	var bounds []windowBound
+	start, quietStart := 0, -1
+	for at := 0; at < len(samples); at += window {
+		end := min(at+window, len(samples))
+		var peak float32
+		var squareSum float64
+		active := 0
+		for _, value := range samples[at:end] {
+			squareSum += float64(value) * float64(value)
+			if value < 0 {
+				value = -value
+			}
+			peak = max(peak, value)
+			if value >= minimumActiveAmplitude {
+				active++
+			}
+		}
+		minimumMeanSquare := float64(minimumWordRMSAmplitude) * float64(minimumWordRMSAmplitude)
+		// All gates must agree that this frame is quiet. Requiring the full
+		// word gate in each tiny frame would discard low-duty-cycle speech
+		// that easily passes the activity-duration gate over a whole word.
+		sounding := peak >= minimumWordPeakAmplitude || squareSum/float64(end-at) >= minimumMeanSquare || active >= minimumActive
+		if !sounding {
+			if quietStart < 0 {
+				quietStart = at
+			}
+			continue
+		}
+		if quietStart > start && at-quietStart >= minimumQuiet {
+			bounds = append(bounds, windowBound{start: start, end: quietStart + handle})
+			start = at - handle
+		}
+		quietStart = -1
+	}
+	if len(bounds) == 0 {
+		return whole
+	}
+	return append(bounds, windowBound{start: start, end: len(samples)})
+}
